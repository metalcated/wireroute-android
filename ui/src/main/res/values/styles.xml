<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <style name="WireGuardTheme.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="AppThemeBase" parent="WireGuardTheme">
        <item name="materialCardViewStyle">@style/WireGuardTheme.MaterialCardView</item>
        <item name="toolbarStyle">@style/WireGuardTheme.Toolbar</item>
        <item name="bottomSheetDialogTheme">@style/WireGuardTheme.BottomSheetDialog</item>
        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
    </style>

    <!-- Various additional API-specific features in values-v*/styles.xml -->
    <style name="AppTheme" parent="AppThemeBase" />

    <style name="WireRouteMainTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorBackground">@color/wire_route_background</item>
        <item name="android:windowBackground">@color/wire_route_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/wire_route_background</item>
        <item name="android:navigationBarColor">@color/wire_route_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="colorPrimary">@color/wire_route_signal_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/wire_route_card</item>
        <item name="colorOnSurface">@color/wire_route_label</item>
        <item name="colorSurfaceVariant">@color/wire_route_raised</item>
        <item name="colorOnSurfaceVariant">@color/wire_route_secondary_label</item>
        <item name="colorSurfaceContainerLowest">@color/wire_route_background</item>
        <item name="colorSurfaceContainerLow">@color/wire_route_inset</item>
        <item name="colorSurfaceContainer">@color/wire_route_card</item>
        <item name="colorSurfaceContainerHigh">@color/wire_route_raised</item>
        <item name="colorSurfaceContainerHighest">@color/wire_route_raised</item>
        <item name="colorOutline">@color/wire_route_border</item>
        <item name="colorOutlineVariant">@color/wire_route_border</item>
        <item name="materialAlertDialogTheme">@style/WireRouteAlertDialogTheme</item>
    </style>

    <style name="WireRouteSystemMainTheme" parent="AppThemeBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_status_bar</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="WireRouteEditorTheme" parent="Theme.Material3.Dark">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="android:colorBackground">@color/wire_route_background</item>
        <item name="android:windowBackground">@color/wire_route_background</item>
        <item name="android:statusBarColor">@color/wire_route_background</item>
        <item name="android:navigationBarColor">@color/wire_route_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="colorPrimary">@color/wire_route_signal_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/wire_route_raised</item>
        <item name="colorOnPrimaryContainer">@color/wire_route_label</item>
        <item name="colorSecondary">@color/wire_route_signal_blue</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSecondaryContainer">@color/wire_route_raised</item>
        <item name="colorOnSecondaryContainer">@color/wire_route_label</item>
        <item name="colorSurface">@color/wire_route_background</item>
        <item name="colorOnSurface">@color/wire_route_label</item>
        <item name="colorSurfaceVariant">@color/wire_route_card</item>
        <item name="colorOnSurfaceVariant">@color/wire_route_secondary_label</item>
        <item name="colorSurfaceContainerLowest">@color/wire_route_background</item>
        <item name="colorSurfaceContainerLow">@color/wire_route_inset</item>
        <item name="colorSurfaceContainer">@color/wire_route_card</item>
        <item name="colorSurfaceContainerHigh">@color/wire_route_raised</item>
        <item name="colorSurfaceContainerHighest">@color/wire_route_raised</item>
        <item name="colorOutline">@color/wire_route_border</item>
        <item name="colorOutlineVariant">@color/wire_route_border</item>
        <item name="colorControlNormal">@color/wire_route_label</item>
        <item name="actionMenuTextColor">@color/wire_route_label</item>
        <item name="materialAlertDialogTheme">@style/WireRouteAlertDialogTheme</item>
        <item name="actionBarTheme">@style/WireRouteActionBarTheme</item>
        <item name="actionBarStyle">@style/WireRouteEditorActionBar</item>
        <item name="materialCardViewStyle">@style/WireRouteEditorCard</item>
        <item name="textInputStyle">@style/WireRouteEditorTextInput</item>
    </style>

    <style name="WireRouteSystemEditorTheme" parent="AppThemeBase">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_status_bar</item>
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="actionMenuTextColor">?attr/colorOnSurface</item>
        <item name="actionBarTheme">@style/WireRouteActionBarTheme</item>
        <item name="actionBarStyle">@style/WireRouteEditorActionBar</item>
        <item name="materialCardViewStyle">@style/WireRouteEditorCard</item>
        <item name="textInputStyle">@style/WireRouteEditorTextInput</item>
    </style>

    <style name="WireRouteAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorBackground">@color/wire_route_raised</item>
        <item name="colorPrimary">@color/wire_route_signal_blue</item>
        <item name="colorSurface">@color/wire_route_raised</item>
        <item name="colorSurfaceContainerHigh">@color/wire_route_raised</item>
        <item name="colorOnSurface">@color/wire_route_label</item>
        <item name="colorOnSurfaceVariant">@color/wire_route_secondary_label</item>
    </style>

    <style name="WireRouteActionBarTheme" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="actionMenuTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="WireRouteLogTheme" parent="WireRouteEditorTheme">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:listDivider">?attr/colorOutline</item>
        <item name="colorSurface">@color/wire_route_background</item>
        <item name="colorSurfaceContainer">@color/wire_route_card</item>
        <item name="colorSurfaceContainerHigh">@color/wire_route_raised</item>
    </style>

    <style name="WireRouteSystemLogTheme" parent="WireRouteSystemEditorTheme">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:listDivider">?attr/colorOutline</item>
    </style>

    <style name="WireRouteEditorActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">?android:attr/colorBackground</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/WireRouteEditorActionBarTitle</item>
    </style>

    <style name="WireRouteEditorActionBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="WireRouteEditorCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="WireRouteEditorTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">?attr/colorOutline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="WireGuardTheme.MaterialCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cornerRadius">4dp</item>
        <item name="contentPadding">8dp</item>
    </style>

    <style name="WireGuardTheme.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="NoBackgroundTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="TvTheme" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
